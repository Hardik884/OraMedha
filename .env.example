# =============================================================================
# OraMedha — Environment Variables Reference
# Copy this file to .env.local and fill in actual values.
# NEVER commit .env.local to version control.
# =============================================================================

# Supabase — safe for browser (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server-side only (NO NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI — server-side only
GOOGLE_AI_API_KEY=your-gemini-api-key

# n8n — server-side only
N8N_WEBHOOK_SECRET=your-shared-secret
N8N_BASE_URL=https://your-n8n-instance.com

# Scheduled jobs — server-side only
# Must equal the `cron_secret` value in Supabase Vault. The cron endpoint
# REFUSES to run when this is unset rather than running unauthenticated.
# See supabase/CRON.md.
CRON_SECRET=a-long-random-string

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Require the platform admin to have two-step verification.
#
# OFF by default, and the default is load-bearing: turning this on before the
# admin account has actually enrolled an authenticator locks that account out of
# the console it would use to fix the problem. The safe sequence is enrol at
# /dentist/settings, confirm sign-in works, THEN set this.
#
# Enrolment itself is always available and needs no flag. Anyone who has
# enrolled is always challenged — that part is automatic. This only governs
# whether an admin WITHOUT a factor is made to add one. See docs/SECURITY.md.
# REQUIRE_ADMIN_MFA=true

# Content-Security-Policy enforcement. Unset (or anything other than "enforce")
# emits Content-Security-Policy-Report-Only, so violations are reported but
# nothing is blocked. Set to "enforce" only AFTER exercising a real deployment
# — sign-in, patient profile, X-ray preview, consent print, portal assistant —
# and confirming the browser console reports no violations. See docs/SECURITY.md.
# CSP_MODE=enforce

# Security contact, published at /.well-known/security.txt (RFC 9116).
#
# UNSET TODAY, and the route 404s while it is. That is deliberate: RFC 9116
# makes Contact mandatory, and a security.txt naming an address nobody monitors
# is worse than none — a researcher who finds one stops looking for another way
# to reach us and reports into a void. Same rule lib/legal/links.ts applies to
# the Terms URL: refuse to invent, publish nothing.
#
# Use a SHARED mailbox, not a person's, so it survives them leaving. Accepts a
# bare address (turned into mailto:) or an https reporting form. Anything else
# is rejected and no file is served.
#
# → REQUIRES AN OPERATIONAL DECISION: pick the address, set this, and fill in
#   the contact row in docs/INCIDENT-RESPONSE.md.
# SECURITY_CONTACT=security@oramedha.com
#
# Optional. Emitted as `Policy:` when set; omitted entirely when not.
# SECURITY_POLICY_URL=https://oramedha.com/security

# =============================================================================
# Published legal documents (marketing site)
# =============================================================================
# The canonical Privacy Policy is published by the OraMedha marketing site, NOT
# by this application — see lib/legal/links.ts. The sign-in pages link out to
# it. Both variables are browser-safe by design: they are public URLs.

# Origin of the marketing site. Defaults to the production origin
# (https://oramedha.com) when unset; override only for a preview deployment.
# NEXT_PUBLIC_MARKETING_URL=https://oramedha.com

# Absolute URL of the published Terms of Service. NO SUCH PAGE EXISTS YET, so
# this is deliberately unset and the sign-in footer omits the Terms clause
# rather than linking to a 404. Set it once Terms are published.
# NEXT_PUBLIC_TERMS_URL=https://oramedha.com/terms

# =============================================================================
# Auth email delivery
# =============================================================================
# NONE of these are read by the Next.js app. Nothing in OraMedha sends an auth
# email: Supabase Auth mints the token, renders the template and hands the
# message to a mail transport. These exist only for the script that configures
# the HOSTED Supabase project:
#
#     npm run auth:email:check    # print what would be sent, secrets redacted
#     npm run auth:email:push     # apply it
#
# Local development needs NONE of them — local Auth sends to Mailpit
# (http://127.0.0.1:55324) and touches no provider at all.
#
# None of these may ever be prefixed NEXT_PUBLIC_, logged, or committed.

# ── Always required by the script ────────────────────────────────────────────

# The deployed origin. EVERY link in EVERY auth email is built from this.
AUTH_SITE_URL=https://your-app.example.com

# Supabase Management API credentials.
# Token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token
SUPABASE_PROJECT_REF=your-project-ref

# ── Resend ───────────────────────────────────────────────────────────────────
# There are two Resend modes, and NEITHER can email a real patient without a
# verified domain. See supabase/EMAIL.md §2 for the comparison.
#
#   resend-test   Only RESEND_SMTP_PASSWORD. Sends from onboarding@resend.dev,
#                 which Resend delivers ONLY to the address your Resend account
#                 was created with — every other recipient is refused. 100/day.
#                     npm run auth:email:push -- --provider=resend-test
#
#   resend        Both variables, with a sender on a domain you have verified
#                 at https://resend.com/domains. No recipient restriction.
#                     npm run auth:email:push -- --provider=resend
#
# Leave both unset and `npm run auth:email:push` selects Supabase's built-in
# service, which needs no credentials and reaches project team members only.
#
# Before trusting either mode, confirm what YOUR account will actually carry —
# it asks the real SMTP server rather than the documentation:
#     RESEND_SMTP_PASSWORD=re_... npm run auth:email:probe -- #       --to <your Resend account address> --to <any other address>

# A Resend API key (https://resend.com/api-keys). This is the SMTP *password*;
# the SMTP username is the literal string "resend".
# RESEND_SMTP_PASSWORD=re_your_resend_api_key

# The From address — for --provider=resend only. Its domain must be Verified in
# Resend first, or every message is rejected. Never a personal mailbox
# (gmail.com and friends publish DMARC policies that forbid third-party
# sending). Leave unset for resend-test, which uses onboarding@resend.dev.
# AUTH_SMTP_SENDER_EMAIL=no-reply@auth.your-domain.com
# AUTH_SMTP_SENDER_NAME=OraMedha
